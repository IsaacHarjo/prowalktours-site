{
  "Walk Page — server component (page.tsx)": {
    "scope": "typescriptreact",
    "prefix": "walkpage-server",
    "description": "Server component for a walk video page. Run in a new app/videos/[slug]/page.tsx file.",
    "body": [
      "import type { Metadata } from \"next\";",
      "import Script from \"next/script\";",
      "import ${1:PascalSlug}Client from \"./${1:PascalSlug}Client\";",
      "",
      "const siteUrl = \"https://www.prowalktours.com\";",
      "const pageUrl = \"https://www.prowalktours.com/videos/${2:slug}\";",
      "const ogImageUrl = \"https://img.youtube.com/vi/${3:youtubeId}/maxresdefault.jpg\";",
      "const metadataTitle = \"${4:Title for search engines}\";",
      "const metadataDescription = \"${5:One-line description under 155 characters.}\";",
      "",
      "export const metadata: Metadata = {",
      "  title: metadataTitle,",
      "  description: metadataDescription,",
      "  alternates: { canonical: pageUrl },",
      "  openGraph: {",
      "    title: metadataTitle,",
      "    description: metadataDescription,",
      "    url: pageUrl,",
      "    images: [{ url: ogImageUrl, alt: \"${6:Alt text for the hero image}\" }],",
      "  },",
      "};",
      "",
      "export default function ${1:PascalSlug}Page() {",
      "  const breadcrumbStructuredData = {",
      "    \"@context\": \"https://schema.org\",",
      "    \"@type\": \"BreadcrumbList\",",
      "    itemListElement: [",
      "      { \"@type\": \"ListItem\", position: 1, name: \"Home\", item: `\\${siteUrl}/` },",
      "      { \"@type\": \"ListItem\", position: 2, name: \"Countries\", item: `\\${siteUrl}/countries` },",
      "      { \"@type\": \"ListItem\", position: 3, name: \"${7:Country}\", item: `\\${siteUrl}/destinations/${8:country-slug}` },",
      "      { \"@type\": \"ListItem\", position: 4, name: \"${9:Short page title}\", item: pageUrl },",
      "    ],",
      "  };",
      "",
      "  const videoStructuredData = {",
      "    \"@context\": \"https://schema.org\",",
      "    \"@type\": \"VideoObject\",",
      "    name: \"${9:Short page title}\",",
      "    description: metadataDescription,",
      "    thumbnailUrl: [ogImageUrl],",
      "    embedUrl: \"https://www.youtube.com/embed/${3:youtubeId}\",",
      "    contentUrl: \"https://www.youtube.com/watch?v=${3:youtubeId}\",",
      "    uploadDate: \"${10:YYYY-MM-DD}\",",
      "    duration: \"${11:PT1H30M0S}\",",
      "    url: pageUrl,",
      "  };",
      "",
      "  return (",
      "    <>",
      "      <Script",
      "        id=\"${2:slug}-breadcrumb-jsonld\"",
      "        type=\"application/ld+json\"",
      "        dangerouslySetInnerHTML={{ __html: JSON.stringify(breadcrumbStructuredData) }}",
      "      />",
      "      <Script",
      "        id=\"${2:slug}-video-jsonld\"",
      "        type=\"application/ld+json\"",
      "        dangerouslySetInnerHTML={{ __html: JSON.stringify(videoStructuredData) }}",
      "      />",
      "      <${1:PascalSlug}Client />",
      "    </>",
      "  );",
      "}",
      ""
    ]
  },

  "Walk Page — video-detail record": {
    "scope": "typescript",
    "prefix": "walkpage-detail",
    "description": "VideoDetailRecord template for data/video-details/[slug].ts",
    "body": [
      "import type { VideoDetailRecord } from \"../video-types\";",
      "",
      "export const ${1:camelSlug}Detail: VideoDetailRecord = {",
      "  slug: \"${2:slug}\",",
      "  heroEyebrow: \"${3:Country} Walk\",",
      "  heroTitle: \"${4:Hero title shown on the page}\",",
      "  heroSubtitle: \"${5:Short subtitle — landmarks or theme}\",",
      "  heroDescription:",
      "    \"${6:Full paragraph describing the walk route.}\",",
      "  routeMapDescription:",
      "    \"${7:One or two sentences describing the route on the map.}\",",
      "  licensingDescription: [",
      "    \"${8:Paragraph 1 describing the footage and its use cases.}\",",
      "    \"If you need licensed access to this footage for commercial, documentary, or creative use, use the licensing page to request a quote and describe the exact shots or time ranges you need.\",",
      "  ],",
      "  highlights: [],",
      "};",
      ""
    ]
  },

  "Highlight card (img with gradient fallback)": {
    "scope": "typescriptreact",
    "prefix": "walkpage-highlight-img",
    "description": "Highlight card image block with empty-src guard and onError gradient fallback",
    "body": [
      "<div className=\"relative aspect-[16/10] overflow-hidden\">",
      "  {highlight.imageSrc ? (",
      "    <img",
      "      src={highlight.imageSrc}",
      "      alt={highlight.alt || highlight.title}",
      "      className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"",
      "      onError={(e) => {",
      "        e.currentTarget.style.display = \"none\";",
      "        e.currentTarget.parentElement!.classList.add(\"bg-gradient-to-br\", \"from-[#2f261d]\", \"to-[#4a3c2f]\");",
      "      }}",
      "    />",
      "  ) : (",
      "    <div className=\"h-full w-full bg-gradient-to-br from-[#2f261d] to-[#4a3c2f]\" />",
      "  )}",
      "</div>"
    ]
  },

  "Breadcrumb nav block": {
    "scope": "typescriptreact",
    "prefix": "walkpage-breadcrumbs",
    "description": "Breadcrumb nav markup used on every walk page",
    "body": [
      "<nav aria-label=\"Breadcrumb\" className=\"mb-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-[#8a7a68]\">",
      "  {breadcrumbs.map((item, index) => (",
      "    <div key={item.label} className=\"inline-flex items-center gap-2\">",
      "      {item.href ? (",
      "        <Link href={item.href} className=\"transition hover:text-[#167fd5]\">{item.label}</Link>",
      "      ) : (",
      "        <span className=\"font-medium text-[#5c4c33]\">{item.label}</span>",
      "      )}",
      "      {index < breadcrumbs.length - 1 ? <span aria-hidden=\"true\" className=\"text-[#bba893]\">/</span> : null}",
      "    </div>",
      "  ))}",
      "</nav>"
    ]
  }
}
