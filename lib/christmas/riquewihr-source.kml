    <Folder>
      <name><![CDATA[Christmas Market & Activites]]></name>
      <Placemark>
        <name>1 - Start of the Walk</name>
        <description>The start and end of the walk are the same place.</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>
            7.299937,48.1662619,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>2. Rue du Genearl de Gaulle</name>
        <description>This is the main street through the town where most of your time will be spent. If you are short on time, just walk to the end of this street to the Upper Gate and turn around come back. </description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>
            7.2994294,48.1663725,0
          </coordinates>
        </Point>
      </Placemark>
