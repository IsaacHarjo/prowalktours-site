<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name><![CDATA[Barcelona Evening Walking Tour Route – Gothic Quarter & El Born]]></name>
    <description><![CDATA[Video Link: https://youtu.be/j7iqGqSLiFE<br><br>Walking route filmed for the Prowalk Tours Barcelona Evening Walking Tour video. The walk explores the Gothic Quarter and El Born districts including La Rambla, Plaça Reial, Santa Maria del Mar, Barcelona Cathedral, and Temple of Augustus.]]></description>
